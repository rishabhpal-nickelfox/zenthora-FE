{
    "navigationFallback": {
        "rewrite": "index.html",
        "exclude": ["/images/*.{png,jpg,gif}", "/css/*"]
    },
    "responseOverrides": {
      "/ngsw.json": {
        "headers": {
          "cache-control": "no-cache, no-store, must-revalidate"
        }
      },
      "/index.html": {
        "headers": {
          "cache-control": "no-cache, no-store, must-revalidate"
        }
      }
  }
}
