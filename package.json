{
  "name": "eps-ui",
  "license": "MIT",
  "engines": {
    "node": ">=18.19.1",
    "npm": ">=9.6.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --ssl true --ssl-cert \"./ssl/cert.pem\"  --ssl-key \"./ssl/key.pem\" --port 63829",
    "start-company-portal": "ng serve company-portal --ssl true --ssl-cert \"./ssl/cert.pem\"  --ssl-key \"./ssl/key.pem\" --configuration development",
    "start-customer-portal": "ng serve customer-portal --ssl true --ssl-cert \"./ssl/cert.pem\"  --ssl-key \"./ssl/key.pem\"",
    "build-increased-heap-size": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build --extra-webpack-config webpack.partial.js --configuration production",
    "post-build": "node ./build/post-build.js",
    "lint": "ng lint",
    "build-company-portal": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build company-portal --extra-webpack-config webpack.partial.js --configuration production && node ./build/post-build-company.js",
    "build-customer-portal": "node --max_old_space_size=8000 ./node_modules/@angular/cli/bin/ng build customer-portal --extra-webpack-config webpack.partial.js --configuration production && node ./build/post-build-customer.js",
    "build-common": "ng build common",
    "pack-common": "ng build common && npm pack ./dist/common --pack-destination ./dist",
    "link-common": "npm run pack-common && npm i ./dist/eps-common-0.0.1.tgz --no-save"
  },
  "private": true,
