{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "eps-ui": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "ngx-build-plus:browser",
          "options": {
            "outputPath": "FE",
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": "projects/common/polyfills.ts",
            "stylePreprocessorOptions": {
              "includePaths": [
                "."
              ]
            },
            "assets": [
              "src/favicon.ico",
              "src/probe.html",
              "src/.htaccess",
              "src/nginx.default",
              "src/robots.txt",
              {
                "glob": "**/*",
                "input": "node_modules/ngx-extended-pdf-viewer/assets/",
                "output": "/assets/"
              },
              {
                "glob": "**/*",
                "input": "projects/common/src/assets/",
                "output": "/assets/"
              },
              {
                "glob": "**/*",
                "input": "projects/company-portal/src/assets",
                "output": "/assets/"
              },
              {
                "glob": "**/*",
                "input": "projects/customer-portal/src/assets",
                "output": "/assets/"
              }
            ],
            "styles": [
              "node_modules/@nebular/theme/styles/prebuilt/default.css",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.css",
              "node_modules/ngx-bootstrap/datepicker/bs-datepicker.css",
              "node_modules/dragula/dist/dragula.css",
              "node_modules/ngx-ui-switch/ui-switch.component.css",
              "node_modules/quill/dist/quill.core.css",
              "node_modules/quill/dist/quill.snow.css",
              "projects/common/src/assets/toastr.scss",
              "projects/company-portal/src/styles.scss",
              "projects/customer-portal/src/styles.scss"
            ],
            "scripts": [
              "node_modules/jquery/dist/jquery.slim.min.js",
              "node_modules/bootstrap/dist/js/bootstrap.js",
              "node_modules/sprintf-js/src/sprintf.js",
              "projects/common/src/assets/hermes/hermes.min.js"
            ],
            "allowedCommonJsDependencies": [
              "decimal.js",
              "deep-equal",
              "moment-timezone",
              "lodash/cloneDeep",
              "assets/hermes/hermes.min.js",
              "util",
              "sprintf-js",
              "eva-icons",
              "dragula",
              "quill-delta",
              "b64-to-blob",
              "moment",
              "text-mask-addons/dist/textMaskAddons",
              "text-mask-core/dist/textMaskCore",
              "dayjs",
              "dayjs/plugin/customParseFormat",
              "dayjs/plugin/isBetween",
              "dayjs/plugin/isSameOrAfter",
              "dayjs/plugin/isSameOrBefore",
              "dayjs/plugin/isoWeek"
            ],
            "serviceWorker": true,
            "ngswConfigPath": "ngsw-config.json"
          },
          "configurations": {
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "tsConfig": "src/tsconfig.dev.json"
            },
            "production": {
              "optimization": true,
              "aot": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "vendorChunk": true,
              "fileReplacements": [
                {
                  "replace": "/environments/environment.ts",
                  "with": "/environments/environment.prod.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "ngx-build-plus:dev-server",
          "options": {
            "buildTarget": "eps-ui:build",
            "port": 3001,
            "host": "0.0.0.0"
          },
          "configurations": {
            "production": {
              "buildTarget": "eps-ui:build:production"
            },
            "development": {
              "buildTarget": "eps-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "eps-ui:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    },
    "company-portal": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
