            "index": "projects/customer-portal/src/index.html",
            "main": "projects/customer-portal/src/main.ts",
            "tsConfig": "projects/customer-portal/tsconfig.app.json",
            "polyfills": "projects/common/polyfills.ts",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": [
                "."
              ]
            },
            "assets": [
              "projects/customer-portal/src/favicon.ico",
              "projects/customer-portal/src/probe.html",
              "projects/customer-portal/src/.htaccess",
              "projects/customer-portal/src/nginx.default",
              "projects/customer-portal/src/robots.txt",
              {
